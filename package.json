{
  "name": "primitive-context",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun run --filter @pc/api dev",
    "dev:web": "bun run --filter @pc/web dev",
    "integrations:generate": "bun run --filter @pc/integrations generate",
    "typecheck": "bun run --filter '*' typecheck",
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test"
  }
}
