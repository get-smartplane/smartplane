{
  "source": "https://github.com/github/github-mcp-server",
  "retrievedAt": "2026-10-23",
  "note": "GitHub's remote MCP server (api.githubcopilot.com/mcp). Names, descriptions and input schemas as the server lists them, trimmed to the main tools.",
  "tools": [
    { "name": "issue_write", "description": "Create a new or update an existing issue in a GitHub repository.",
      "inputSchema": { "type": "object", "properties": {
        "method": { "type": "string", "enum": ["create", "update"] }, "owner": { "type": "string" }, "repo": { "type": "string" },
        "issue_number": { "type": "number", "description": "Issue number to update" }, "title": { "type": "string" }, "body": { "type": "string" },
        "state": { "type": "string", "enum": ["open", "closed"] }, "state_reason": { "type": "string", "enum": ["completed", "not_planned", "duplicate"] },
        "labels": { "type": "array", "items": { "type": "string" } }, "assignees": { "type": "array", "items": { "type": "string" } }, "milestone": { "type": "number" }
      }, "required": ["method", "owner", "repo"] } },
    { "name": "issue_read", "description": "Get information about a specific issue in a GitHub repository.",
      "inputSchema": { "type": "object", "properties": { "method": { "type": "string", "enum": ["get", "get_comments", "get_sub_issues", "get_parent", "get_labels"] }, "owner": { "type": "string" }, "repo": { "type": "string" }, "issue_number": { "type": "number" } }, "required": ["method", "owner", "repo", "issue_number"] },
      "annotations": { "readOnlyHint": true } },
    { "name": "list_issues", "description": "List issues in a GitHub repository.",
      "inputSchema": { "type": "object", "properties": { "owner": { "type": "string" }, "repo": { "type": "string" }, "state": { "type": "string", "enum": ["OPEN", "CLOSED"] }, "labels": { "type": "array", "items": { "type": "string" } } }, "required": ["owner", "repo"] },
      "annotations": { "readOnlyHint": true } },
    { "name": "add_issue_comment", "description": "Add a comment and/or reaction to a specific issue or issue comment in a GitHub repository. Works for pull requests too.",
      "inputSchema": { "type": "object", "properties": { "owner": { "type": "string" }, "repo": { "type": "string" }, "issue_number": { "type": "number" }, "body": { "type": "string" }, "reaction": { "type": "string", "enum": ["+1", "-1", "laugh", "confused", "heart", "hooray", "rocket", "eyes"] } }, "required": ["owner", "repo", "issue_number"] } },
    { "name": "create_pull_request", "description": "Create a new pull request in a GitHub repository.",
      "inputSchema": { "type": "object", "properties": { "owner": { "type": "string" }, "repo": { "type": "string" }, "title": { "type": "string" }, "head": { "type": "string", "description": "Branch containing changes" }, "base": { "type": "string", "description": "Branch to merge into" }, "body": { "type": "string" }, "draft": { "type": "boolean" } }, "required": ["owner", "repo", "title", "head", "base"] } },
    { "name": "update_pull_request", "description": "Update an existing pull request in a GitHub repository.",
      "inputSchema": { "type": "object", "properties": { "owner": { "type": "string" }, "repo": { "type": "string" }, "pullNumber": { "type": "number" }, "title": { "type": "string" }, "body": { "type": "string" }, "state": { "type": "string", "enum": ["open", "closed"] }, "base": { "type": "string" }, "draft": { "type": "boolean" } }, "required": ["owner", "repo", "pullNumber"] } },
    { "name": "merge_pull_request", "description": "Merge a pull request in a GitHub repository.",
      "inputSchema": { "type": "object", "properties": { "owner": { "type": "string" }, "repo": { "type": "string" }, "pullNumber": { "type": "number" }, "merge_method": { "type": "string", "enum": ["merge", "squash", "rebase"] }, "commit_title": { "type": "string" } }, "required": ["owner", "repo", "pullNumber"] } },
    { "name": "pull_request_read", "description": "Get information on a specific pull request in GitHub repository (details, diff, status, files, commits, reviews, comments).",
      "inputSchema": { "type": "object", "properties": { "method": { "type": "string", "enum": ["get", "get_diff", "get_status", "get_files", "get_commits", "get_review_comments", "get_reviews", "get_comments", "get_check_runs"] }, "owner": { "type": "string" }, "repo": { "type": "string" }, "pullNumber": { "type": "number" } }, "required": ["method", "owner", "repo", "pullNumber"] },
      "annotations": { "readOnlyHint": true } },
    { "name": "list_pull_requests", "description": "List pull requests in a GitHub repository.",
      "inputSchema": { "type": "object", "properties": { "owner": { "type": "string" }, "repo": { "type": "string" }, "state": { "type": "string", "enum": ["open", "closed", "all"] }, "base": { "type": "string" } }, "required": ["owner", "repo"] },
      "annotations": { "readOnlyHint": true } },
    { "name": "push_files", "description": "Push multiple files to a GitHub repository in a single commit.",
      "inputSchema": { "type": "object", "properties": { "owner": { "type": "string" }, "repo": { "type": "string" }, "branch": { "type": "string" }, "files": { "type": "array", "items": { "type": "object", "properties": { "path": { "type": "string" }, "content": { "type": "string" } } } }, "message": { "type": "string" } }, "required": ["owner", "repo", "branch", "files", "message"] } },
    { "name": "create_or_update_file", "description": "Create or update a single file in a GitHub repository (one commit on the given branch).",
      "inputSchema": { "type": "object", "properties": { "owner": { "type": "string" }, "repo": { "type": "string" }, "path": { "type": "string" }, "content": { "type": "string" }, "message": { "type": "string" }, "branch": { "type": "string" }, "sha": { "type": "string" } }, "required": ["owner", "repo", "path", "content", "message", "branch"] } },
    { "name": "delete_file", "description": "Delete a file from a GitHub repository.",
      "inputSchema": { "type": "object", "properties": { "owner": { "type": "string" }, "repo": { "type": "string" }, "path": { "type": "string" }, "message": { "type": "string" }, "branch": { "type": "string" } }, "required": ["owner", "repo", "path", "message", "branch"] },
      "annotations": { "readOnlyHint": false, "destructiveHint": true } },
    { "name": "create_branch", "description": "Create a new branch in a GitHub repository.",
      "inputSchema": { "type": "object", "properties": { "owner": { "type": "string" }, "repo": { "type": "string" }, "branch": { "type": "string" }, "from_branch": { "type": "string" } }, "required": ["owner", "repo", "branch"] } },
    { "name": "get_file_contents", "description": "Get the contents of a file or directory from a GitHub repository.",
      "inputSchema": { "type": "object", "properties": { "owner": { "type": "string" }, "repo": { "type": "string" }, "path": { "type": "string" }, "ref": { "type": "string" } }, "required": ["owner", "repo"] },
      "annotations": { "readOnlyHint": true } }
  ]
}
